{
  "name": "rieb-snor-cnc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CNC foam letter nesting and Mach3 toolpath generator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:e2e:firefox": "playwright test --project=firefox"
  },
  "dependencies": {
    "@fontsource/battambang": "^5.3.0",
    "@fontsource/moul": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
